# Server
PORT=5000
NODE_ENV=development
MONGO_URI=mongodb://localhost:27017/packwise
JWT_SECRET=your_jwt_secret_key_here
JWT_EXPIRES_IN=7d

# AI — ChatGPT (OpenAI) and Claude (Anthropic)
# Each AI task is routed to the best configured model and falls back automatically. Set at least one key.
# Direct APIs:
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
# ...or through OpenRouter (the same OpenRouter key can be used for both):
OPENROUTER_GPT_KEY=
OPENROUTER_CLAUDE_KEY=

# Model preset (see server/services/ai/modelCatalog.js):
#   balanced (default) → trip planning: GPT-6.1 Sol + Claude Opus 5.5 · chat: GPT-6 Luna + Claude Sonnet 5.5
#   max                → trip planning: GPT-6 Astra + Claude Fable 5.1 · chat: GPT-6.1 Sol + Claude Opus 5.5
#                        (most capable models, roughly 2.5-5x the cost and slower)
AI_MODEL_PRESET=balanced
# Optional per-model overrides, e.g. when a newer model ships (Anthropic IDs use hyphens, OpenRouter slugs use dots):
# OPENAI_MODEL_SMART=gpt-6.1-sol
# OPENAI_MODEL_FAST=gpt-6-luna
# ANTHROPIC_MODEL_SMART=claude-opus-5-5
# ANTHROPIC_MODEL_FAST=claude-sonnet-5-5
# OPENROUTER_GPT_MODEL_SMART=openai/gpt-6.1-sol
# OPENROUTER_GPT_MODEL_FAST=openai/gpt-6-luna
# OPENROUTER_CLAUDE_MODEL_SMART=anthropic/claude-opus-5.5
# OPENROUTER_CLAUDE_MODEL_FAST=anthropic/claude-sonnet-5.5

# Client
VITE_API_URL=http://localhost:5000/api
