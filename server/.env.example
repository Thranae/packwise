# Server Port & Environment
PORT=5000
NODE_ENV=development

# Database Connection
MONGO_URI=mongodb://localhost:27017/packwise

# JWT Authentication & Refresh Security
JWT_SECRET=your_super_secret_jwt_access_key
JWT_REFRESH_SECRET=your_super_secret_jwt_refresh_key
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Primary AI Provider (Google Gemini)
GEMINI_API_KEY=your_gemini_api_key_here

# High-Speed AI Fallback Providers
GROQ_API_KEY=your_groq_api_key_here
NVIDIA_API_KEY=your_nvidia_api_key_here
OPENAI_API_KEY=your_openai_api_key_here
MISTRAL_API_KEY=your_mistral_api_key_here
OPENROUTER_API_KEY=your_openrouter_api_key_here

# Weather & Flight Tracking APIs
OPENWEATHER_API_KEY=your_openweather_api_key_here
AVIATIONSTACK_API_KEY=your_aviationstack_api_key_here

# Visual Discovery & Unsplash/Pexels/Pixabay Multi-Key Pools
UNSPLASH_API_KEY=your_unsplash_access_key
PEXELS_API_KEY=your_pexels_api_key
PIXABAY_API_KEY=your_pixabay_api_key

# Email & SMS Dispatch
BREVO_API_KEY=your_brevo_api_key_here
TWILIO_ACCOUNT_SID=your_twilio_sid
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_PHONE_NUMBER=your_twilio_phone_number
